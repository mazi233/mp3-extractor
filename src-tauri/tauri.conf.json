{
  "$schema": "https://raw.githubusercontent.com/nicepkg/vscode-tauri/refs/heads/dev/schemas/tauri.conf.schema.json",
  "productName": "MP3 Extractor",
  "version": "0.1.0",
  "identifier": "com.mp3-extractor.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "抖音视频转音频",
        "width": 480,
        "height": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
